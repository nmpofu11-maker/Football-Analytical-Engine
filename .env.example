# Optional AI parsing/research. Core prediction does not require Gemini.
GEMINI_API_KEY=""

# Optional model name for AI-assisted parsing/research.
GEMINI_MODEL="gemini-2.5-flash"

# Public application URL (optional).
APP_URL=""

# Verified fixture providers.
SPORTAPI_AI_KEY=""
THERUNDOWN_KEY=""

# Optional score-provider URL. Keep the API key in the hosting secret store.
RESULTS_API_URL=""
API_FOOTBALL_KEY=""

# Required for all browser/API write operations. Generate a long random secret and set it in the hosting secret store.
# The browser will prompt for this value when a write action is used; it is kept for this tab session only.
ADMIN_API_KEY=""

# Required only if you expose POST /api/results/push-scores.
RESULTS_WEBHOOK_SECRET=""
