# Optional AI parsing/research. Core prediction does not require Gemini.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Public application URL (optional).
APP_URL=""

# Verified fixture providers. Keep real credentials only in your local .env or hosting secret store.
SPORTAPI_AI_KEY=""
SPORTMONKS_API_KEY=""
# Optional override for provider API base URL; leave blank to use the official default.
SPORTMONKS_BASE_URL=""
THERUNDOWN_KEY=""

# Optional score-provider URL. Keep the API key in the hosting secret store.
RESULTS_API_URL=""
API_FOOTBALL_KEY=""

# Required for all browser/API write operations. Generate a long random secret and set it in the hosting secret store.
# The browser will prompt for this value when a write action is used; it is kept for this tab session only.
ADMIN_API_KEY=""

# Required only if you expose POST /api/results/push-scores.
RESULTS_WEBHOOK_SECRET=""

# Optional absolute path for application JSON data. In production, point this at a persistent mounted volume.
# The default ./data directory may be ephemeral on serverless/container platforms.
DATA_DIR=""
